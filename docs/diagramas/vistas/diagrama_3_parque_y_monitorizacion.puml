@startuml MagicWorld_ParqueYMonitorizacion

!theme plain
hide circle
skinparam linetype ortho
skinparam backgroundColor #FFFFFF

' Ajustamos la separación para el formato vertical
skinparam nodesep 90
skinparam ranksep 130

' Tamaños masivos para LaTeX
skinparam titleFontSize 50

skinparam class {
    BackgroundColor #EBF5FB
    BorderColor #1278DF
    HeaderBackgroundColor #1278DF
    HeaderFontColor White
    FontName Arial
    FontSize 35
    AttributeFontSize 35
}

skinparam class<<externo>> {
    BackgroundColor #F0F0F0
    BorderColor #999999
    HeaderBackgroundColor #999999
    HeaderFontColor White
}

skinparam package {
    BackgroundColor #FAFAFA
    BorderColor #ADB5BD
    FontColor #212529
    FontStyle bold
    FontSize 35
}

skinparam arrow {
    Color #343A40
    FontSize 30
    FontColor #555555
    Thickness 3.0
}

skinparam note {
    FontSize 30
}

title "<b>MagicWorld — Parque y Monitorización</b>"

' ─────────────────────────────────────────
package "Parque" {
    class ParkZone {
        zoneName    : String
        description : String
    }
    class Attraction {
        name              : String
        category          : AttractionCategory
        intensity         : Intensity
        minimumHeight     : Integer
        minimumAge        : Integer
        minimumWeight     : Integer
        description       : String
        photoUrl          : String
        maintenanceStatus : MaintenanceStatus
        isActive          : Boolean
        mapPositionX      : Double
        mapPositionY      : Double
        openingTime       : LocalTime
        closingTime       : LocalTime
        zone              : ParkZone
    }
}

' ─────────────────────────────────────────
package "Monitorización" {
    class ParkEvent {
        eventType    : ParkEventType
        timestamp    : LocalDateTime
        attractionId : Long
        userId       : Long
        visitorCount : Integer
        queueSize    : Integer
        metadata     : String
    }
    class ParkAlert {
        alertType    : AlertType
        severity     : AlertSeverity
        message      : String
        suggestion   : String
        attractionId : Long
        isActive     : Boolean
        timestamp    : LocalDateTime
        resolvedAt   : LocalDateTime
    }
}

' ─────────────────────────────────────────
package "Operaciones" {
    class ParkClosureDay {
        closureDate : LocalDate
        reason      : String
    }
}

package "Ref. Compras" <<Frame>> {
    class PurchaseLine <<externo>> {
        validDate : LocalDate
    }
}

' ─────────────────────────────────────────
' ENLACES OCULTOS PARA FORZAR APILAMIENTO VERTICAL
' ─────────────────────────────────────────
' Estos enlaces invisibles obligan al motor a dibujar 
' las clases de abajo literalmente debajo de las de arriba
Attraction -[hidden]down-> ParkAlert
ParkZone -[hidden]down-> ParkEvent
ParkEvent -[hidden]down-> ParkClosureDay
ParkAlert -[hidden]down-> PurchaseLine

' ─────────────────────────────────────────
'  RELACIONES (con dirección forzada)
' ─────────────────────────────────────────
' Forzamos que la flecha apunte hacia abajo o hacia arriba para evitar ensanchar
ParkZone  "1" -down-* "0..*" Attraction  : "alberga >"
ParkAlert "0..*" -up-.> "0..1" Attraction  : "relacionada con >"

' Estas dos clases más pequeñas las ponemos de lado abajo del todo
ParkClosureDay "0..*" -right-.> PurchaseLine : "bloquea validDate de >"

' ─────────────────────────────────────────
' NOTAS (Todas reubicadas al fondo para no ganar anchura)
' ─────────────────────────────────────────
note bottom of ParkEvent
  Registro histórico de eventos del parque.
  attractionId y userId son referencias
  denormalizadas (sin FK) para
  eficiencia analítica y de rendimiento.
end note

note bottom of ParkAlert
  Alertas operacionales en tiempo real.
  Incluyen sugerencia y attractionId.
  Son consultadas por DailyAssignment
  y ReinforcementCall.
end note

note bottom of ParkClosureDay
  Registro de días de cierre del parque.
  Se usa en checkout para impedir
  compras en fechas no operativas.
end note

note bottom of PurchaseLine
  Entidad del Diagrama 1.
  Se muestra aquí como referencia.
end note

@enduml